# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — never commit real secrets.
# In production, set all four in Vercel → Settings → Environment Variables.

# ---------------------------------------------------------------- Supabase
# Supabase dashboard → Project Settings → API

# Project URL, e.g. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Privileged key, used server-side only. Depending on how old your Supabase
# project is, this is either:
#   - API Keys -> "Secret keys" -> default          (sb_secret_...)   [current]
#   - API Keys -> "Legacy anon, service_role" tab   (eyJhbGci...)     [older]
# Both work and both bypass row-level security. NOT the publishable/anon key,
# which is read-only and can't write projects.
#
# SERVER-ONLY: never prefix it with NEXT_PUBLIC_, never reference it in a
# client component, and rotate it if it's ever committed or pasted publicly.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------- Admin

# Password for the dashboard at /admin.
# Defaults to "ernieblaze2026" if unset. Change it before deploying.
ADMIN_PASSWORD=

# Signs the admin session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without it, sessions are signed with a value derived from the password, so
# changing the password signs you out everywhere. Set it in production.
ADMIN_SESSION_SECRET=
